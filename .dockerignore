.venv/
.git/
data/
evals/data/
evals/runs/
evals/workspace/
evals/workspaces/*/workspace/
evals/workspaces/*/data/
evals/workspaces/*/runs/
evals/workspaces/*/cache/
legacy/
node_modules/
frontend/node_modules/
frontend/dist/
__pycache__/
*.pyc
.DS_Store
data/catalog_v2_logs/
FUTURE.md

# Secrets & local runtime config: compose injects env at runtime and mounts the
# workspace config, so the image needs none of these. Excluding them keeps
# credentials out of local builds AND any published image. (.env.*.example stay
# in the repo for host-side `--env-file`, but are never needed inside the image.)
.env
.env.*
workspace.json
workspace.runtime.json
*.pem
*.key
*.p12
id_rsa*
.codex/
.claude/
# but the build genuinely needs CA bundles dropped in certs/*.pem for proxied
# (enterprise) builds — keep that directory in the context.
!certs/
