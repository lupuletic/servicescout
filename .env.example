# Copy to .env, fill in real values. Never commit .env.
#
# REQUIRED

# Where your git repos live (or where the crawler should clone them).
# Mounted into the crawler container as /workspace.
WORKSPACE_ROOT=/Users/me/work

# Workspace-specific runtime state. Keep this distinct per workspace to avoid
# overwriting another catalog. Examples:
#   main:      SERVICESCOUT_DATA_DIR=./data
#   sock-shop: SERVICESCOUT_DATA_DIR=./evals/data
SERVICESCOUT_DATA_DIR=./data

# Org/exclusion config used by crawler and scheduler.
SERVICESCOUT_WORKSPACE_CONFIG=./workspace.json

# Google Cloud project that owns your Vertex AI quota for embeddings.
# Leave empty to skip embeddings (the catalog will fall back to lexical-only search).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# LLM provider: 'codex' or 'claude'. The container has both CLIs installed.
LLM_PROVIDER=codex
LLM_MODEL=gpt-5.4-mini
LLM_EFFORT=high

# At least one of these is required (depending on LLM_PROVIDER above):
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Hard cost cap for a single `docker compose run crawler` invocation.
BUDGET_USD=100

# OPTIONAL — uid/gid for the cg user inside the container. On Linux, set these
# to match your host user so bind-mounted writes have the right ownership.
HOST_UID=1000
HOST_GID=1000

# Image tag to deploy (default: latest)
SERVICESCOUT_VERSION=latest

# Optional build-time package mirrors/proxies for restricted corporate
# networks. Leave blank for normal public PyPI/npm.
PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_NO_INDEX=
PIP_FIND_LINKS=/tmp/wheels
NPM_CONFIG_REGISTRY=

# Direct service bind addresses. These are useful for local use without nginx,
# and can differ per workspace if you run two stacks side by side.
SERVICESCOUT_MCP_BIND=127.0.0.1:8765
SERVICESCOUT_DASHBOARD_BIND=127.0.0.1:8788

# Remote/self-contained deployment: nginx edge bind address for
# `docker compose --profile scheduler --profile edge up -d`.
# Use 127.0.0.1:8080 for SSH-tunnel-only access, or 0.0.0.0:80 behind a
# firewall / load balancer / TLS terminator.
SERVICESCOUT_HTTP_BIND=127.0.0.1:8080

# Continuous crawl scheduler defaults.
CRAWL_INTERVAL_MINUTES=360
CRAWL_TICK_BUDGET_USD=20
