# Run ServiceScout against the isolated Weaveworks sock-shop eval workspace.
# Usage:
#   docker compose --env-file .env.socks-shop.example up -d mcp dashboard
#   docker compose --env-file .env.socks-shop.example --profile edge up -d
#
# This points Compose at evals/data, so the default catalog in ./data is untouched.

WORKSPACE_ROOT=./evals/workspace
SERVICESCOUT_WORKSPACE_CONFIG=./evals/workspace_orgs.json
SERVICESCOUT_DATA_DIR=./evals/data
SERVICESCOUT_MCP_BIND=127.0.0.1:8791
SERVICESCOUT_DASHBOARD_BIND=127.0.0.1:8790
SERVICESCOUT_HTTP_BIND=127.0.0.1:8081

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

LLM_PROVIDER=codex
LLM_MODEL=gpt-5.4-mini
LLM_EFFORT=medium

# Passed through to provider tooling and future direct API harnesses. Verify
# the selected CLI is authenticated inside the crawler container before crawling.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

BUDGET_USD=20
CRAWL_INTERVAL_MINUTES=360
CRAWL_TICK_BUDGET_USD=5

HOST_UID=1000
HOST_GID=1000
SERVICESCOUT_VERSION=latest

PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_NO_INDEX=
PIP_FIND_LINKS=/tmp/wheels
NPM_CONFIG_REGISTRY=
CODEX_CLI_VERSION=latest
CLAUDE_CODE_VERSION=latest
