# --- Local config and secrets ---
.env
.env.local
*.local.json
workspace.json
seeds/*.json
!seeds/*.example.json

# --- Generated catalog state ---
data/
.demo-data/

# --- Roadmap notes kept locally ---
FUTURE.md

# --- Runtime state ---
.claude/scheduled_tasks.lock
.claude/projects/

# --- Build artifacts ---
.venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
build/
dist/
node_modules/
vendor/wheels/*
!vendor/wheels/.gitkeep

# --- Logs ---
*.log
logs/

# --- Optional corporate CA bundle (TLS-inspecting proxies). Never commit. ---
certs/
!certs/
certs/*
!certs/.gitkeep

# --- Legacy / experiment scratch ---
legacy/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# --- Coverage / test output ---
.pytest_cache/
.coverage
htmlcov/
