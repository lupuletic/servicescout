# Run ServiceScout against your main/private workspace.
# Copy to .env.main or pass directly with --env-file after replacing paths.
# This points Compose at ./data, preserving the default catalog location.

WORKSPACE_ROOT=/Users/me/work
SERVICESCOUT_WORKSPACE_CONFIG=./workspace.json
SERVICESCOUT_DATA_DIR=./data
SERVICESCOUT_MCP_BIND=127.0.0.1:8765
SERVICESCOUT_DASHBOARD_BIND=127.0.0.1:8788
SERVICESCOUT_HTTP_BIND=127.0.0.1:8080

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

LLM_PROVIDER=codex
LLM_MODEL=gpt-5.4-mini
LLM_EFFORT=high

# Extractor auth. Local dev: leave blank and let Compose mount your logged-in
# CLI (~/.codex / ~/.claude). Headless/VM: set CODEX_API_KEY (codex; the crawler
# then runs with --ignore-user-config) and/or ANTHROPIC_API_KEY (claude) to run
# with no mounted login state. Prefer CODEX_API_KEY over OPENAI_API_KEY for codex.
CODEX_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

BUDGET_USD=100
CRAWL_INTERVAL_MINUTES=360
CRAWL_TICK_BUDGET_USD=20

HOST_UID=1000
HOST_GID=1000
SERVICESCOUT_VERSION=latest

PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_NO_INDEX=
PIP_FIND_LINKS=/tmp/wheels
NPM_CONFIG_REGISTRY=
CODEX_CLI_VERSION=latest
CLAUDE_CODE_VERSION=latest
