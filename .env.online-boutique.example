# Run ServiceScout against the isolated Google Online Boutique eval workspace.
# Usage:
#   docker compose --env-file .env.online-boutique.example up -d mcp dashboard
#   docker compose --env-file .env.online-boutique.example --profile edge up -d
#
# This points Compose at evals/workspaces/online-boutique/data, so other
# workspace catalogs are untouched.

WORKSPACE_ROOT=./evals/workspaces/online-boutique/workspace
SERVICESCOUT_WORKSPACE_CONFIG=./evals/workspaces/online-boutique/workspace_orgs.json
SERVICESCOUT_DATA_DIR=./evals/workspaces/online-boutique/data
SERVICESCOUT_MCP_BIND=127.0.0.1:8793
SERVICESCOUT_DASHBOARD_BIND=127.0.0.1:8792
SERVICESCOUT_HTTP_BIND=127.0.0.1:8082

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

LLM_PROVIDER=codex
LLM_MODEL=gpt-5.4-mini
LLM_EFFORT=medium

OPENAI_API_KEY=
ANTHROPIC_API_KEY=

BUDGET_USD=20
CRAWL_INTERVAL_MINUTES=360
CRAWL_TICK_BUDGET_USD=5

HOST_UID=1000
HOST_GID=1000
SERVICESCOUT_VERSION=latest

PIP_INDEX_URL=
PIP_EXTRA_INDEX_URL=
PIP_TRUSTED_HOST=
PIP_NO_INDEX=
PIP_FIND_LINKS=/tmp/wheels
NPM_CONFIG_REGISTRY=
